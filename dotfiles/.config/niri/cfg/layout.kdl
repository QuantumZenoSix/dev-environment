    layout {
        gaps 32 // Gap between windows
        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        // center-focused-column "never" // Don’t auto-center focused column
        // always-center-single-column

        // Optional: Set a default width for the column
        default-column-width { 
            // proportion 0.66667
            proportion 0.6
        }

        // preset-column-widths {
        //     proportion 0.33333
        //     proportion 0.5
        //     proportion 0.66667
        // }

        preset-column-widths {
            proportion 0.2
            proportion 0.6
            proportion 0.8
        }


        struts {}

        focus-ring {
            on
            width 1.5
        }

        border {
            width 0.5
        }

        shadow {
            // off
            on
            softness 30
            spread 5
            offset x=0 y=5
            draw-behind-window true
            color "#00000070"
            // inactive-color "#00000054"
        }

        tab-indicator {
            width 8
            gap 0
            length total-proportion=0.3
            position "left"
            place-within-column
        }

    }
