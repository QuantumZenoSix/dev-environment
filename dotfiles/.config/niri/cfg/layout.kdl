    layout {
        gaps 4 // Gap between windows
        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        // center-focused-column "never" // Don’t auto-center focused column
        always-center-single-column

        // Optional: Set a default width for the column
        // default-column-width { 
        //     proportion 0.66667
        // }

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        struts {}

        focus-ring {
            on
            width 1.5
        }

        border {
            width 0.5
        }

        tab-indicator {
            width 8
            gap 0
            length total-proportion=0.3
            position "left"
            place-within-column
        }

    }
